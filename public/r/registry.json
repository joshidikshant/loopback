    {
      "name": "loopback-components",
      "type": "registry:file",
      "title": "Loopback component recipes",
      "description": "Vanilla CSS recipes for the shadcn component vocabulary (lb-btn, lb-badge, lb-card, lb-table, lb-input, lb-pin). No Tailwind, no build step, no React \u2014 every value comes from the loopback-theme tokens.",
      "registryDependencies": [
        "@loopback/loopback-theme"
      ],
      "files": [
        {
          "path": "design/components.css",
          "type": "registry:file",
          "target": "~/loopback-components.css"
        }
      ]
