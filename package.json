{
  "name": "loopback-mcp-server",
  "mcpName": "io.github.joshidikshant/loopback",
  "author": "Dikshant Joshi",
  "version": "0.9.2",
  "files": [
    "dist",
    "widget",
    "public",
    "design",
    "integrations",
    "skills",
    "registry.json",
    "CHANGELOG.md"
  ],
  "description": "Loopback \u2014 a project-tagged feedback bus for coding agents (Claude Code, Codex, Gemini CLI) over MCP. Capture UI/backend/usage/UX feedback once; let any agent claim, fix, and write the change back.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "loopback-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "bump": "node scripts/bump-version.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "node scripts/release-preflight.mjs",
    "preflight": "node scripts/release-preflight.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "npm run build && node dist/smoke-test.js",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "init-gate": "node scripts/init-gate.mjs",
    "registry-gate": "node scripts/registry-gate.mjs",
    "registry:build": "npx --yes shadcn@latest build ./registry.json --output ./public/r",
    "registry:validate": "npx --yes shadcn@latest registry validate ./registry.json",
    "clean": "rm -rf dist",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard-gate": "node scripts/dashboard-gate.mjs",
    "impeccable-gate": "node scripts/impeccable-gate.mjs",
    "widget-token-gate": "node scripts/widget-token-gate.mjs",
    "a11y-gate": "node scripts/a11y-gate.mjs",
    "canary": "node scripts/canary-all.mjs",
    "verify:release": "node scripts/release-verify.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshidikshant/loopback.git"
  },
  "homepage": "https://github.com/joshidikshant/loopback#readme",
  "bugs": {
    "url": "https://github.com/joshidikshant/loopback/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "feedback",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "impeccable": "3.3.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
